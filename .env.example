# --- Required ---
# Anthropic API key used by the Claude Agent SDK to drive the agent.
ANTHROPIC_API_KEY=

# OAuth bearer token for Robinhood's Agentic Trading MCP server.
# Obtain via Robinhood's Agentic Trading setup flow.
ROBINHOOD_MCP_TOKEN=

# --- Optional (sensible defaults shown) ---
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
CLAUDE_MODEL=claude-opus-4-8

# Safety: when false (default), order-placement tools are removed from the
# allowlist entirely, so the agent runs in dry-run / analysis-only mode.
ALLOW_TRADING=false

# Hard risk caps (enforced in the system prompt).
MAX_ORDER_VALUE_USD=500
MAX_DAILY_SPEND_USD=2000

# Comma-separated ticker allowlist. Empty = any symbol allowed.
ALLOWED_SYMBOLS=

# Free-text strategy injected into the system prompt. Leave blank to use the
# conservative built-in default in robinhood_agent/prompts.py.
STRATEGY=

# ===========================================================================
# Deterministic technical-analysis engine ( `python -m robinhood_agent trade` )
# ===========================================================================

# Brokerage account the TA engine trades. REQUIRED for `trade --execute`.
# Must be an agentic-enabled account number (the engine never guesses it).
ROBINHOOD_ACCOUNT_NUMBER=

# Default universe scanned when no symbols are passed on the CLI.
WATCH_SYMBOLS=AAPL,MSFT,NVDA,SPY

# Candle interval and history depth.
DATA_INTERVAL=1d
LOOKBACK_BARS=300

# Act when blended confidence ≥ this (0-1). 0.65 = "above a 65% rating".
CONFIDENCE_THRESHOLD=0.65
# Sensitivity of conviction to net evidence (higher = more decisive).
DECISION_GAIN=3.0

# Factor weights (relative; need not sum to 1).
WEIGHT_MOMENTUM=0.25
WEIGHT_SUPPORT_RESISTANCE=0.20
WEIGHT_FIBONACCI=0.15
WEIGHT_ORDERFLOW=0.25
WEIGHT_LIQUIDITY=0.15

# Liquidity gate: dollar volume below MIN is suppressed; at/above GOOD is full.
LIQ_MIN_DOLLAR_VOL=1000000
LIQ_GOOD_DOLLAR_VOL=25000000

# Risk & sizing.
ATR_STOP_MULT=2.0
MIN_RISK_REWARD=1.5
SIZE_FLOOR_FRAC=0.5

# Order routing. 'limit' = marketable, price-protected (default); or 'market'.
ORDER_TYPE=limit
SLIPPAGE_BPS=10
TIME_IN_FORCE=gfd
MARKET_HOURS=regular_hours
